#!/bin/bash
cd $(dirname $(dirname $0)) || exit

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_DIR="backups"
mkdir -p "$BACKUP_DIR"

MYSQL_ROOT_PW=$(grep MYSQL_ROOT_PASSWORD environment/mysql-admin.env | cut -d= -f2)

echo ">> Đang sao lưu Database MySQL sang $BACKUP_DIR/ndoj_db_$TIMESTAMP.sql.gz ..."
docker compose exec -T db mysqldump -u root -p"$MYSQL_ROOT_PW" ndoj | gzip > "$BACKUP_DIR/ndoj_db_$TIMESTAMP.sql.gz"

echo ">> Đang sao lưu thư mục problems và media ..."
tar -czf "$BACKUP_DIR/ndoj_data_$TIMESTAMP.tar.gz" problems media

echo ">> Sao lưu thành công tại thư mục $BACKUP_DIR/!"
ls -lh "$BACKUP_DIR"
